# Copy to /etc/systemd/system/beseder.service (adjust User= and the paths).
[Unit]
Description=Beseder mail client
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Beseder
Environment=BESEDER_DATA_DIR=/home/pi/Beseder/data
ExecStart=/home/pi/Beseder/.venv/bin/python -m beseder
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
